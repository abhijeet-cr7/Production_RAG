# ──────────────────────────────────────────────
# LLM Providers (pick one free provider)
# ──────────────────────────────────────────────
# Groq — free tier: https://console.groq.com
GROQ_API_KEY=

# Google Gemini — free tier: https://aistudio.google.com
GEMINI_API_KEY=

# Cohere — free tier: https://dashboard.cohere.com
COHERE_API_KEY=

# Mistral — free tier: https://console.mistral.ai
MISTRAL_API_KEY=

# OpenAI / Anthropic (paid)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# Embedding model
# ──────────────────────────────────────────────
# provider: sentence-transformers (local/free) | openai | cohere | gemini
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ──────────────────────────────────────────────
# Kafka
# ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHUNKS=rag.chunks
KAFKA_CONSUMER_GROUP=embedding-workers

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_EMBEDDING_CACHE_TTL=86400

# ──────────────────────────────────────────────
# Vector DB (Qdrant)
# ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=production_rag
QDRANT_API_KEY=

# ──────────────────────────────────────────────
# API Gateway
# ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────
# Retrieval
# ──────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ──────────────────────────────────────────────
# Chunking
# ──────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ──────────────────────────────────────────────
# Web search (Tavily) — https://app.tavily.com
# ──────────────────────────────────────────────
# Empty key = web search stays disabled (local corpus only).
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MIN_LOCAL_RESULTS=3
WEB_SEARCH_MIN_RELEVANCE_SCORE=0.0
TAVILY_SEARCH_DEPTH=basic

# ──────────────────────────────────────────────
# Generation grading (hallucination + usefulness check)
ANSWER_GRADING_ENABLED=true
GRADER_PROVIDER=groq
GRADER_MODEL=openai/gpt-oss-20b
MAX_GENERATION_ATTEMPTS=2
# Answer policy for ungrounded output is per tenant: config/tenant_policies.yaml

# Authentication — production uses Okta (Authorization Server → Access Policies)
APP_ENV=dev                      # dev | staging | prod
AUTH_MODE=okta                   # okta | dev_token | disabled (last two: APP_ENV=dev only)
OKTA_ISSUER=https://YOUR-ORG.okta.com/oauth2/default
OKTA_AUDIENCE=api://default
# Custom claims added on the Okta authorization server:
OKTA_TENANT_CLAIM=tenant_id
OKTA_GROUPS_CLAIM=groups
OKTA_CLEARANCE_CLAIM=clearance
# Local development without Okta:
#   AUTH_MODE=dev_token  DEV_JWT_SECRET=<32+ random chars>
#   TENANT_POLICIES_PATH=config/tenant_policies.dev.yaml
#   python scripts/make_dev_token.py --tenant dev --scopes rag:query,rag:ingest
TENANT_POLICIES_PATH=config/tenant_policies.yaml

# Audit log (hash-chained). AUDIT_HMAC_KEY is required outside dev.
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_HMAC_KEY=
AUDIT_FAIL_CLOSED=true

# Ingestion safety
INGEST_MAX_UPLOAD_BYTES=26214400        # 25 MB per uploaded file
INGEST_MAX_FETCH_BYTES=10485760         # 10 MB per fetched URL/API response
INGEST_RATE_LIMIT_PER_MINUTE=20         # URL/API ingests per user (per process)
PARSER_TIMEOUT_SECONDS=120              # sandboxed parser limits
PARSER_MAX_MEMORY_MB=1024
PDF_MAX_PAGES=500

# Provenance
VERIFIED_PUBLISHERS=sec.gov             # hosts whose https content counts as verified_primary
RAW_STORE_ENABLED=true
RAW_STORE_DIR=data/raw

# Answer safety
REQUIRE_CITATIONS=true
ANSWER_VERIFICATION_ENABLED=true

# Document lifecycle
RETENTION_DAYS=0                        # 0 = keep forever; used by scripts/purge_expired.py

# Vector store (required outside APP_ENV=dev)
QDRANT_API_KEY=

# Host ports for docker compose (scripts/docker-up.sh picks free ones if these are busy)
# API_PORT=8000
# FRONTEND_PORT=8080
# QDRANT_PORT=6333
# REDIS_PORT=6379

# Observability (LangSmith) — https://smith.langchain.com
# ──────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag
LANGSMITH_HIDE_CONTENT=true            # hide prompts/answers in traces
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
